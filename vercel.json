{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/proxy.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/app/:path*", "destination": "/api/proxy" },
    { "source": "/static/:path*", "destination": "/api/proxy" },
    { "source": "/styles.css", "destination": "/api/proxy" },
    { "source": "/script.js", "destination": "/api/proxy" },
    { "source": "/signup", "destination": "/api/proxy" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
