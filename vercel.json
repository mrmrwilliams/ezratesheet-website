{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/app/:path*", "destination": "https://origin.ezratesheet.com/app/:path*" }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "X-Forwarded-Host", "value": "ezratesheet.com" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
